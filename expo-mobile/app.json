{
  "expo": {
    "name": "XCharge",
    "slug": "xcharge-mobile-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "xcharge",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b10"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.kwesii.xchargemobileapp",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070b10"
      },
      "navigationBar": {
        "visible": "sticky-immersive",
        "backgroundColor": "#00000000"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "androidStatusBar": {
      "hidden": true,
      "translucent": true
    },
    "ios": {
      "bundleIdentifier": "com.kwesii.xchargemobileapp",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "XCharge needs your location to find nearby EV charging stations across Ghana."
      }
    },
    "extra": {
      "eas": {
        "projectId": "cf022c9c-25fc-4642-9441-919f9fb2b92f"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
