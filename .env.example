# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Moolre Ghana SMS Gateway Credentials (OTP Verification)
MOOLRE_VAS_KEY=""
MOOLRE_SENDER_ID="ChargeLink"

# Paystack server-side payment collection (use sk_test_... while testing)
# Never expose PAYSTACK_SECRET_KEY in frontend code or commit it to Git.
PAYSTACK_SECRET_KEY="sk_test_replace_with_your_paystack_secret_key"
# Public key is not needed for the hosted checkout flow currently used by Wilpower.
# PAYSTACK_PUBLIC_KEY="pk_test_replace_with_your_paystack_public_key"
# Use the deployed callback URL. For local testing, use http://localhost:5173/payments/paystack/callback.
PAYSTACK_CALLBACK_URL="https://your-vercel-domain.vercel.app/payments/paystack/callback"

# Wilpower Operations Portal
# If these credentials are omitted, the safe first-login defaults are:
# Email: admin@wilpower.local
# Password: WilpowerLocalAdmin!2026
# The portal forces a password change after the first successful login.
# Set all three values before deploying when using a custom production account.
WILPOWER_ADMIN_EMAIL="admin@wilpower.energy"
WILPOWER_ADMIN_PASSWORD="replace-with-a-long-unique-password"
WILPOWER_ADMIN_NAME="Wilpower Administrator"
WILPOWER_ADMIN_ROLE="super_admin"
WILPOWER_ADMIN_SESSION_SECRET="replace-with-a-long-random-session-secret"
